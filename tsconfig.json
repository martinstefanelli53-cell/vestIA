{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "vitest/config"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@shared/*": ["supabase/functions/api/*"] }
  },
  "include": ["src", "vite.config.ts", "supabase/functions/api/taxonomy.ts"]
}
